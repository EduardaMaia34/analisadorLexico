{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Tonto Lexer",
            "type": "shell",
            "command": "flex -o lex.yy.cpp tonto_lexer.l && g++ -std=c++17 -g main.cpp lex.yy.cpp -o tonto_lexer",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        }
    ]
}