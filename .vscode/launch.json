{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Executar/Depurar Tonto Lexer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/tonto_lexer",
            "args": ["testes/Universidade.tonto"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Habilitar reformatação automática para gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Tonto Lexer"
        }
    ]
}